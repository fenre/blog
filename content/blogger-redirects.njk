---
# Gamle Blogger-adresser (/2023/02/<slug>.html) videresendes til de nye postene.
pagination:
  data: collections.postsSortedNo
  size: 1
  alias: post
permalink: "{{ post.data.source | replace('https://www.fsudmann.com', '') }}"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="nb">
<head>
<meta charset="utf-8">
<title>{{ post.data.title }}</title>
<link rel="canonical" href="{{ metadata.siteUrl }}{{ post.url }}">
<meta http-equiv="refresh" content="0; url={{ post.url | url }}">
<meta name="robots" content="noindex">
</head>
<body><p><a href="{{ post.url | url }}">{{ post.data.title }}</a></p></body>
</html>
